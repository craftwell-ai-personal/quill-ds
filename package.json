{
  "name": "quill-ds",
  "version": "1.23.3",
  "private": true,
  "license": "MIT",
  "scripts": {
    "predev": "npm run build:icons",
    "dev": "next dev",
    "prebuild": "npm run build-storybook -- -o public/storybook",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prestorybook": "npm run build:icons",
    "storybook": "storybook dev -p 6006",
    "prebuild-storybook": "npm run build:tokens && npm run build:icons && npm run build:usage && npm run build:agent-rules && npm run build:registry && npm run build:llms",
    "build-storybook": "storybook build",
    "build:tokens": "node scripts/build-tokens.mjs",
    "build:registry": "shadcn build",
    "build:llms": "node scripts/build-llms.mjs",
    "build:usage": "node scripts/build-usage.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:icon-manifest": "node scripts/build-manifest.mjs",
    "build:agent-rules": "node scripts/build-agent-rules.mjs",
    "build:check": "node scripts/build-check.mjs",
    "drift-audit": "node scripts/drift-audit.mjs",
    "pattern-scan": "node scripts/pattern-scan.mjs",
    "pretest:tokens": "npm run build:icons",
    "test:tokens": "node --test src/tokens/*.test.mjs scripts/*.test.mjs scripts/lib/*.test.mjs scripts/paper/*.test.mjs",
    "paper:sync": "node scripts/paper/sync.mjs",
    "paper:check": "node scripts/paper/check.mjs",
    "paper:status": "node scripts/paper/status.mjs",
    "paper:daily": "node scripts/paper/daily.mjs",
    "paper:schedule": "node scripts/paper/schedule.mjs",
    "eval:selection": "node scripts/agent-selection-eval.mjs",
    "pretest-storybook": "npm run build:icons",
    "test-storybook": "vitest --project=storybook run",
    "pretest-storybook:watch": "npm run build:icons",
    "test-storybook:watch": "vitest --project=storybook",
    "pretest-storybook:coverage": "npm run build:icons",
    "test-storybook:coverage": "vitest --project=storybook run --coverage",
    "pretest-storybook:theme": "npm run build:icons",
    "test-storybook:theme": "vitest --config scripts/theme-qa/vitest.config.ts --project=storybook run --reporter=dot --reporter=json --outputFile.json=.figma-type-audit/theme-qa/${QUILL_THEME:-light}.json",
    "figma:visual": "node --env-file=.env scripts/figma-visual-diff.mjs --out .visual/out --sb .visual/sb"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@material-symbols/svg-400": "^0.47.6",
    "@modelcontextprotocol/server": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "mcp-handler": "^2.2.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-storybook": "^10.6.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.10"
  }
}
